# ==============================================================================
# Sooatel Flow - Backend Environment Variables Template (.env.example)
# ==============================================================================

# Database Configuration (PostgreSQL 16 with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=sooatel_db

# Security & Authentication (JWT Tokens)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
REFRESH_SECRET=your_super_secret_refresh_key_at_least_32_characters

# Transactional Mailer (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Sooatel Flow <no-reply@sooatel.mg>"
FRONTEND_URL=http://localhost:5173

# LLM Orchestration (DeepSeek API)
DEEPSEEK_KEY=your_deepseek_api_key_here

# Local Embeddings Cache (Optional, @xenova/transformers)
# TRANSFORMERS_CACHE=./.cache

